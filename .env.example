# Copiá este archivo a .env.local y completá los valores. .env.local nunca se sube al repo.
# Acá solo van los nombres: nunca pongas una clave real en este archivo.

# --- Red ---
# Red de Celo: "celo-sepolia" (testnet, para desarrollar) o "celo" (mainnet, desde el 4 nov).
NEXT_PUBLIC_CHAIN=celo-sepolia
# Tag de atribución de la hackathon (empieza con celo_). Está en AGENTS.md; pedíselo a Mavi si no lo ves.
NEXT_PUBLIC_ATTRIBUTION_TAG=

# --- Wallet del agente (solo servidor) ---
# Clave privada de la wallet del agente (0x...). Solo la tiene Mavi; para desarrollar no hace falta. Nunca la compartas.
AGENT_PRIVATE_KEY=

# --- Base de datos (Supabase) ---
# URL del proyecto: Supabase > Project Settings > Data API (https://xxxx.supabase.co).
SUPABASE_URL=
# Clave secreta: Supabase > Project Settings > API Keys, la "secret" (sb_secret_...) o la service_role. Nunca la publishable/anon.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string de Postgres, solo para correr migraciones desde scripts: Supabase > Connect (botón arriba) > Connection string.
SUPABASE_DB_URL=

# --- IA ---
# API key de Claude: console.anthropic.com > API Keys (empieza con sk-ant-).
ANTHROPIC_API_KEY=

# --- Avisos ---
# Twilio > Console > Account Info: Account SID (empieza con AC).
TWILIO_ACCOUNT_SID=
# Twilio > Console > Account Info: Auth Token.
TWILIO_AUTH_TOKEN=
# Número de WhatsApp que manda los avisos, con formato whatsapp:+14155238886 (el del sandbox de Twilio sirve para probar).
TWILIO_WHATSAPP_FROM=
# API key de Resend para el mail de respaldo: resend.com > API Keys (empieza con re_).
RESEND_API_KEY=

# --- Tareas programadas ---
# Contraseña que protege /api/cron. Inventá una larga (por ejemplo con: openssl rand -hex 32).
CRON_SECRET=
# Unidad de los plazos de 3 y 6: "days" (real) o "minutes" (para probar los recordatorios rápido).
TIME_UNIT=days
