# Copiá este archivo a .env.local y completá los valores. .env.local nunca se sube al repo.
# Acá solo van los nombres: nunca pongas una clave real en este archivo.

# --- Red ---
# Red de Celo: "celo-sepolia" (testnet, para desarrollar) o "celo" (mainnet, desde el 4 nov).
NEXT_PUBLIC_CHAIN=celo-sepolia
# Tag de atribución de la hackathon (empieza con celo_). Está en AGENTS.md; pedíselo a Mavi si no lo ves.
NEXT_PUBLIC_ATTRIBUTION_TAG=

# --- Wallet del agente (solo servidor) ---
# Clave privada de la wallet del agente (0x...). Solo la tiene Mavi; para desarrollar no hace falta. Nunca la compartas.
AGENT_PRIVATE_KEY=

# --- Base de datos (Supabase) ---
# URL del proyecto: Supabase > Project Settings > Data API (https://xxxx.supabase.co).
SUPABASE_URL=
# Clave secreta: Supabase > Project Settings > API Keys, la "secret" (sb_secret_...) o la service_role. Nunca la publishable/anon.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string de Postgres, solo para correr migraciones desde scripts: Supabase > Connect (botón arriba) > Connection string.
SUPABASE_DB_URL=

# --- IA ---
# API key de Google Gemini (capa gratuita): aistudio.google.com > Get API key. Solo servidor.
GEMINI_API_KEY=
# Opcional: modelo que lee el texto del intake (PAC-35). Si queda vacío usa gemini-3.1-flash-lite.
INTAKE_MODEL=

# --- Avisos ---
# Token del bot de Telegram, generado por @BotFather. Ver docs/telegram.md.
TELEGRAM_BOT_TOKEN=
# Clave del webhook del bot: inventá una larga (letras, números, _ y -). La usa `npm run telegram:webhook` y Vercel.
TELEGRAM_WEBHOOK_SECRET=
# Nombre del bot sin @ (por ejemplo pacta_test_bot). Sin esto no se muestra el botón "Recibir avisos por Telegram".
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# API key de Resend para el mail de respaldo: resend.com > API Keys (empieza con re_).
RESEND_API_KEY=
# Remitente de los mails (opcional). Sin valor se usa el de prueba de Resend. Con tu dominio verificado: Pactá <avisos@tudominio.com>.
EMAIL_FROM=
# Dirección pública de la web, para los links de los mails (opcional). Sin valor se usa el dominio de Vercel.
NEXT_PUBLIC_APP_URL=

# --- Tareas programadas ---
# Contraseña que protege /api/cron. Inventá una larga (por ejemplo con: openssl rand -hex 32).
CRON_SECRET=
# Unidad de los plazos de 3 y 6: "days" (real) o "minutes" (para probar los recordatorios rápido).
TIME_UNIT=days

# Tope por pago del liberador, en unidades enteras del token (ej. 500). Vacío = sin tope en testnet.
# En mainnet es OBLIGATORIO para cada moneda. 1 wBRL y 1 wARS valen muy distinto, así que cada una puede tener el suyo;
# la que no tenga usa el general.
MAX_PAYOUT_PER_MILESTONE=
MAX_PAYOUT_PER_MILESTONE_ARS=
MAX_PAYOUT_PER_MILESTONE_BRL=
MAX_PAYOUT_PER_MILESTONE_MXN=

# Aprobación de Mavi para operar en mainnet (chain 42220). SOLO se pone en Vercel Production; nunca en .env.local.
# Sin "yes" el agente no opera en mainnet.
APPROVED_MAINNET=

# Textile FX (opcional): URL de la API de cotizaciones. Por defecto la pública de Textile.
TEXTILE_API_URL=
